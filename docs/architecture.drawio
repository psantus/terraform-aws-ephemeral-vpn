<mxfile host="app.diagrams.net" agent="terracloud" version="24.0.0">
  <diagram id="ephemeral-vpn" name="Ephemeral VPN">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Ephemeral AWS Client VPN — fixed egress IP, SSO login, $0 idle" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="760" height="30" as="geometry" />
        </mxCell>

        <!-- User -->
        <mxCell id="user" value="User&#10;(browser + AWS VPN Client)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="60" height="110" as="geometry" />
        </mxCell>

        <!-- IdP -->
        <mxCell id="idc" value="IAM Identity Center&#10;(SAML: 3 apps — client / portal / cognito)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="820" y="60" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- Web/auth plane -->
        <mxCell id="cf" value="CloudFront + S3&#10;(static SPA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="220" y="80" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cognito" value="Cognito User Pool&#10;(Hosted UI, PKCE)&#10;federated → IDC (SAML)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="480" y="70" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="apigw" value="API Gateway (HTTP API)&#10;Cognito JWT authorizer&#10;GET/POST /vpn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="220" y="200" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="lambda" value="Toggle Lambda (in-VPC)&#10;on / off / status&#10;+ ensures 0.0.0.0/0 route&#10;+ self-discovers egress IP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="480" y="200" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="idle" value="EventBridge (hourly)&#10;→ idle-check Lambda&#10;disassociate if idle 1h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="480" y="330" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- VPC boundary -->
        <mxCell id="vpc" value="Shared VPC (RAM)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;strokeColor=#666666;dashed=1;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="220" y="440" width="620" height="220" as="geometry" />
        </mxCell>
        <mxCell id="cvpn" value="AWS Client VPN endpoint&#10;federated SAML auth + self-service portal&#10;auto self-signed CA-chain server cert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="250" y="480" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="subnet" value="Private subnet&#10;(on-demand association)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="560" y="490" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nat" value="NAT Gateway&#10;fixed Elastic IP&#10;(the egress IP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="560" y="590" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="internet" value="Internet&#10;(traffic appears from the fixed NAT IP)" style="cloud;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="900" y="560" width="200" height="110" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="endArrow=block;html=1;" edge="1" parent="1" source="user" target="cf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="login (PKCE)" style="endArrow=block;html=1;" edge="1" parent="1" source="cf" target="cognito"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="SAML" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="cognito" target="idc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="JWT" style="endArrow=block;html=1;" edge="1" parent="1" source="cf" target="apigw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="endArrow=block;html=1;" edge="1" parent="1" source="apigw" target="lambda"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="associate / route" style="endArrow=block;html=1;" edge="1" parent="1" source="lambda" target="cvpn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="endArrow=block;html=1;" edge="1" parent="1" source="idle" target="cvpn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="VPN (SAML login)" style="endArrow=block;html=1;" edge="1" parent="1" source="user" target="cvpn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="endArrow=block;html=1;" edge="1" parent="1" source="cvpn" target="subnet"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="0.0.0.0/0" style="endArrow=block;html=1;" edge="1" parent="1" source="subnet" target="nat"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="endArrow=block;html=1;" edge="1" parent="1" source="nat" target="internet"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="portal SAML" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="cvpn" target="idc"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
